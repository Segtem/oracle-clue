{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oracle-clue.dev/schemas/hallazgos-v1.json",
  "title": "Oracle Clue review report",
  "type": "object",
  "required": [
    "schema_version",
    "repo",
    "base",
    "head",
    "diff_sha256",
    "provider",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "oracle-clue.review/v1"
    },
    "repo": {
      "type": "string"
    },
    "base": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "diff_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "severity",
          "confidence",
          "title",
          "explanation",
          "location",
          "trigger",
          "evidence",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "bug",
              "seguridad",
              "regresion",
              "discrepancia_con_spec",
              "pregunta"
            ]
          },
          "severity": {
            "enum": [
              "critica",
              "alta",
              "media",
              "baja",
              "informativa"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "required": [
              "file",
              "start_line"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "related_requirement": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "pendiente",
              "corregido",
              "descartado",
              "riesgo_aceptado"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
