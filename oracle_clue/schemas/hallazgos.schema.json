{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oracle-clue:review:v1",
  "title": "Oracle Clue review report",
  "type": "object",
  "required": [
    "schema_version",
    "repo",
    "base",
    "head",
    "diff_sha256",
    "provider",
    "findings",
    "context_sha256",
    "review_status",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "oracle-clue.review/v1"
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "head": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "diff_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "type": "object",
      "required": [
        "name",
        "model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "severity",
          "confidence",
          "title",
          "explanation",
          "location",
          "trigger",
          "evidence",
          "status",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "bug",
              "seguridad",
              "regresion",
              "discrepancia_con_spec",
              "pregunta"
            ]
          },
          "severity": {
            "enum": [
              "critica",
              "alta",
              "media",
              "baja",
              "informativa"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "required": [
              "file",
              "start_line",
              "side",
              "end_line"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "side": {
                "enum": [
                  "base",
                  "head"
                ]
              }
            },
            "additionalProperties": false
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "related_requirement": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "const": "pendiente",
            "description": "La revisión del modelo nunca contiene decisiones humanas."
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_status": {
      "enum": [
        "completo",
        "incompleto"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "incompleto"
          }
        }
      },
      "then": {
        "properties": {
          "limitations": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
